# Copy this file to .env and fill in real values. Never commit .env.
#
# Copernicus Data Space / Sentinel Hub OAuth client credentials.
# Create one at: https://shapps.dataspace.copernicus.eu/dashboard/
# Required for fetching real Sentinel-2 imagery (dates >= 2015-06-23).
# Landsat dates (1984-2015-06-23) use Microsoft Planetary Computer's
# public STAC catalog and don't need credentials.
SENTINELHUB_CLIENT_ID=
SENTINELHUB_CLIENT_SECRET=
